{
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "importOrder": [
    "^(react/(.*)$)|^(react$)",
    "^(next/(.*)$)|^(next$)",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@workspace/(.*)$",
    "",
    "^types$",
    "^@/types/(.*)$",
    "^@/config/(.*)$",
    "^@/lib/(.*)$",
    "^@/hooks/(.*)$",
    "^@/components/ui/(.*)$",
    "^@/components/(.*)$",
    "^@/registry/(.*)$",
    "^@/styles/(.*)$",
    "^@/app/(.*)$",
    "^@/www/(.*)$",
    "",
    "^[./]"
  ],
  "importOrderParserPlugins": [
    "typescript",
    "jsx",
    "decorators-legacy"
  ],
  "sortTailwindcss": {
    "stylesheet": "./apps/v4/app/globals.css",
    "functions": [
      "cn",
      "cva"
    ]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".next",
    "build",
    ".contentlayer",
    "**/fixtures",
    "deprecated",
    "apps/v4/registry/styles/**/*.css"
  ]
}
